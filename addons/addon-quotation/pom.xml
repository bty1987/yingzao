<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yingzao</groupId>
        <artifactId>yingzao</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>addon-quotation</artifactId>
    <name>addon-quotation</name>
    <description>报价 addon:定稿线×审核线双态位正交(老裸状态位写入口不迁)+功能区/功能项明细+费率三元组快照(版本带出)+服务端金额聚合(修老信任前端总价)+锁定供 decoration 预签门槛回补;事件契约入 addons-api(错误码段 230000)</description>

    <dependencies>
        <dependency>
            <groupId>com.yingzao</groupId>
            <artifactId>yingzao-addons-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.yingzao</groupId>
            <artifactId>yingzao-core</artifactId>
        </dependency>
        <!-- F4b 单测批:JUnit5 仅 test 域,运行时 jar 零变化;内核测试基座走 core test-jar -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.yingzao</groupId>
            <artifactId>yingzao-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
