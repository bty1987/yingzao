<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yingzao</groupId>
        <artifactId>yingzao</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>yingzao-app</artifactId>
    <name>yingzao-app</name>
    <description>组装壳:按配置装配内核与 addon,产出一个可运行单体</description>

    <dependencies>
        <dependency>
            <groupId>com.yingzao</groupId>
            <artifactId>yingzao-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yingzao</groupId>
            <artifactId>addon-customer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yingzao</groupId>
            <artifactId>addon-customerprofile</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yingzao</groupId>
            <artifactId>addon-example</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yingzao</groupId>
            <artifactId>addon-basedata</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yingzao</groupId>
            <artifactId>addon-payment</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
